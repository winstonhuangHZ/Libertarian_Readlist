[{"x0": 410.00000000000006, "y0": 104.58333333333334, "x1": 1040.0, "y1": 150.41666666666669, "h": 45.833333333333336, "text": "THE EPISTLE DEDICATORY."}, {"x0": 212.91666666666669, "y0": 187.91666666666669, "x1": 1225.8333333333335, "y1": 229.58333333333334, "h": 41.66666666666667, "text": "done it with due submission, and also (in order to my"}, {"x0": 215.00000000000003, "y0": 226.25, "x1": 1225.4166666666667, "y1": 267.9166666666667, "h": 41.66666666666667, "text": ".. iHect) necessarily ; for they are the Outworks of the"}, {"x0": 213.75, "y0": 277.9166666666667, "x1": 1220.4166666666667, "y1": 319.58333333333337, "h": 41.66666666666667, "text": "TV-.'T\u00bb/, from whence they impugne the Civill Power."}, {"x0": 232.08333333333337, "y0": 308.33333333333337, "x1": 1222.9166666666667, "y1": 350.0, "h": 41.66666666666667, "text": ". notwithstanding this, you find my labour generally"}, {"x0": 212.91666666666669, "y0": 350.83333333333337, "x1": 1225.4166666666667, "y1": 392.50000000000006, "h": 41.66666666666667, "text": "decryed, you may be pleased to excuse your selfe, and"}, {"x0": 211.66666666666666, "y0": 390.0, "x1": 1223.3333333333335, "y1": 431.6666666666667, "h": 41.66666666666667, "text": "say I am a man that love my own opinions, and think"}, {"x0": 212.91666666666669, "y0": 431.25000000000006, "x1": 1221.6666666666667, "y1": 472.9166666666667, "h": 41.66666666666667, "text": "all true I say, that I honoured your Brother, and honour"}, {"x0": 212.50000000000003, "y0": 490.0, "x1": 1222.9166666666667, "y1": 531.6666666666666, "h": 41.66666666666667, "text": "you, and have presum'd on that, to assume the Title"}, {"x0": 639.5833333333334, "y0": 497.50000000000006, "x1": 715.0, "y1": 539.1666666666667, "h": 41.66666666666667, "text": "SIR,"}, {"x0": 214.16666666666669, "y0": 514.1666666666667, "x1": 1004.5833333333334, "y1": 555.8333333333334, "h": 41.66666666666667, "text": "(without your knowledge) of being, as I am,"}, {"x0": 412.9166666666667, "y0": 609.1666666666666, "x1": 937.5000000000001, "y1": 650.8333333333334, "h": 41.66666666666667, "text": "Your most humble, and most"}, {"x0": 765.4166666666666, "y0": 652.5, "x1": 1069.1666666666667, "y1": 694.5833333333334, "h": 42.083333333333314, "text": "obedient servant,"}, {"x0": 212.91666666666669, "y0": 713.7500000000001, "x1": 1177.9166666666667, "y1": 755.4166666666667, "h": 41.66666666666667, "text": "Paris. Aprill Jf. 1651. THO. HOBBES."}]