[{"x0": 529.1666666666667, "y0": 266.6666666666667, "x1": 591.6666666666667, "y1": 308.33333333333337, "h": 41.66666666666667, "text": "TO"}, {"x0": 177.08333333333334, "y0": 356.6666666666667, "x1": 940.4166666666667, "y1": 406.6666666666667, "h": 50.0, "text": "MY MOST HONOR'D FRIEND"}, {"x0": 219.58333333333337, "y0": 409.1666666666667, "x1": 897.0833333333335, "y1": 459.1666666666667, "h": 50.0, "text": "Mr FRANCIS GO DOLPHIN"}, {"x0": 412.9166666666667, "y0": 476.66666666666674, "x1": 715.8333333333335, "y1": 527.0833333333334, "h": 50.41666666666665, "text": "of Godolphin."}, {"x0": 60.00000000000001, "y0": 569.1666666666666, "x1": 288.33333333333337, "y1": 606.6666666666667, "h": 37.5, "text": "Honored Sir,"}, {"x0": 100.83333333333334, "y0": 609.5833333333334, "x1": 1058.3333333333335, "y1": 651.2500000000001, "h": 41.66666666666667, "text": "YOUR most worthy Brother Mr Sidney Godolphin,"}, {"x0": 59.58333333333334, "y0": 659.1666666666666, "x1": 1059.1666666666667, "y1": 700.8333333333334, "h": 41.66666666666667, "text": "when he lived, was pleas'd to think my studies something,"}, {"x0": 60.41666666666667, "y0": 682.0833333333334, "x1": 1048.3333333333335, "y1": 723.75, "h": 41.66666666666667, "text": "and otherwise to oblige me, as you know, with reall testi"}, {"x0": 59.58333333333334, "y0": 723.3333333333334, "x1": 1062.9166666666667, "y1": 765.0, "h": 41.66666666666667, "text": "monies of his good opinion, great in themselves, and the"}, {"x0": 58.75, "y0": 763.7500000000001, "x1": 1068.75, "y1": 805.4166666666667, "h": 41.66666666666667, "text": "greater for the worthinesse of his person. For there is"}, {"x0": 58.75, "y0": 804.5833333333334, "x1": 1062.0833333333335, "y1": 846.25, "h": 41.66666666666667, "text": "not any vertue that disposeth a man, either to the"}, {"x0": 58.333333333333336, "y0": 845.0000000000001, "x1": 1060.8333333333335, "y1": 886.6666666666667, "h": 41.66666666666667, "text": "service of God, or to the service of his Country, to Civill"}, {"x0": 58.75, "y0": 887.0833333333334, "x1": 1060.0, "y1": 928.7500000000001, "h": 41.66666666666667, "text": "Society, or private Friendship, that did not manifestly"}, {"x0": 60.00000000000001, "y0": 926.6666666666667, "x1": 1057.9166666666667, "y1": 968.3333333333334, "h": 41.66666666666667, "text": "appear in his conversation, not as acquired by necessity,"}, {"x0": 59.58333333333334, "y0": 967.0833333333334, "x1": 1066.6666666666667, "y1": 1008.75, "h": 41.66666666666667, "text": "or affected upon occasion, but inhaerent, and shining in"}, {"x0": 59.58333333333334, "y0": 1007.5000000000001, "x1": 1066.6666666666667, "y1": 1049.1666666666667, "h": 41.66666666666667, "text": "a generous constitution of his nature. Therefore in"}, {"x0": 58.75, "y0": 1048.75, "x1": 1060.4166666666667, "y1": 1090.4166666666667, "h": 41.66666666666667, "text": "honour and gratitude to him, and with devotion to your"}, {"x0": 58.333333333333336, "y0": 1090.0000000000002, "x1": 1057.9166666666667, "y1": 1131.6666666666667, "h": 41.66666666666667, "text": "selfe, I humbly Dedicate unto you this my discourse"}, {"x0": 58.75, "y0": 1128.3333333333335, "x1": 1062.5, "y1": 1170.0000000000002, "h": 41.66666666666667, "text": "of Common-wealth. I know not how the, world will"}, {"x0": 58.333333333333336, "y0": 1170.4166666666667, "x1": 1058.75, "y1": 1212.0833333333333, "h": 41.66666666666667, "text": "receive it, nor how it may reflect on those that shall seem"}, {"x0": 60.00000000000001, "y0": 1211.25, "x1": 1057.0833333333333, "y1": 1252.9166666666667, "h": 41.66666666666667, "text": "to favour it. For in a way beset with those that contend,"}, {"x0": 59.58333333333334, "y0": 1252.5000000000002, "x1": 1059.1666666666667, "y1": 1294.1666666666667, "h": 41.66666666666667, "text": "on one side for too great Liberty, and on the other side"}, {"x0": 60.00000000000001, "y0": 1309.1666666666667, "x1": 1062.0833333333335, "y1": 1350.8333333333335, "h": 41.66666666666667, "text": "for too much Authority, 'tis hard to passe between the"}, {"x0": 58.75, "y0": 1334.5833333333335, "x1": 1062.0833333333335, "y1": 1376.6666666666667, "h": 42.083333333333194, "text": "points of both unwounded. But yet, me thinks, the"}, {"x0": 58.75, "y0": 1371.6666666666667, "x1": 1064.1666666666667, "y1": 1413.3333333333335, "h": 41.66666666666667, "text": "endeavour to advance the Civill Power, should not be"}, {"x0": 59.58333333333334, "y0": 1415.8333333333335, "x1": 1069.1666666666667, "y1": 1457.5000000000002, "h": 41.66666666666667, "text": "by the Civill Power condemned ; nor private men, by"}, {"x0": 58.75, "y0": 1457.0833333333335, "x1": 1060.8333333333335, "y1": 1498.75, "h": 41.66666666666667, "text": "reprehending it, declare they think that Power too"}, {"x0": 58.75, "y0": 1500.8333333333335, "x1": 1060.4166666666667, "y1": 1542.5, "h": 41.66666666666667, "text": "great. Besides, -I speak not of the men, but (in the"}, {"x0": 59.58333333333334, "y0": 1537.916666666667, "x1": 1060.0, "y1": 1579.5833333333335, "h": 41.66666666666667, "text": "Abstract) of the Seat of Power, (like to those simple and"}, {"x0": 59.58333333333334, "y0": 1578.3333333333335, "x1": 1059.5833333333335, "y1": 1620.0000000000002, "h": 41.66666666666667, "text": "unpartiall creatures in the Roman Capitol, that with"}, {"x0": 60.41666666666667, "y0": 1619.5833333333335, "x1": 1062.9166666666667, "y1": 1661.25, "h": 41.66666666666667, "text": "their noyse defended those within it, not because they"}, {"x0": 60.41666666666667, "y0": 1658.7500000000002, "x1": 1057.9166666666667, "y1": 1700.416666666667, "h": 41.66666666666667, "text": "were they, but there,) offending none, I think, but those"}, {"x0": 61.25, "y0": 1699.5833333333333, "x1": 1057.9166666666667, "y1": 1741.6666666666667, "h": 42.08333333333343, "text": "without, or such within (if there be any such) as favour"}, {"x0": 58.75, "y0": 1740.4166666666667, "x1": 1057.9166666666667, "y1": 1782.0833333333335, "h": 41.66666666666667, "text": "them. That which perhaps may most offend, are certain"}, {"x0": 59.58333333333334, "y0": 1782.0833333333335, "x1": 1055.8333333333335, "y1": 1823.75, "h": 41.66666666666667, "text": "Texts of Holy Scripture, alledged by me to other purpose"}, {"x0": 60.00000000000001, "y0": 1821.6666666666667, "x1": 1058.3333333333335, "y1": 1863.3333333333335, "h": 41.66666666666667, "text": "than ordinarily they use to be by others. But I have"}, {"x0": 529.1666666666667, "y0": 1835.8333333333335, "x1": 591.2500000000001, "y1": 1877.9166666666667, "h": 42.083333333333194, "text": "B 2"}]