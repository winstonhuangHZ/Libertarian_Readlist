[{"x0": 342, "y0": 78, "x1": 1075, "y1": 143, "h": 65, "text": "The Advantages of Poverty"}, {"x0": 234, "y0": 185, "x1": 1230, "y1": 231, "h": 46, "text": "Every earnest good man, anxious to leave the"}, {"x0": 191, "y0": 240, "x1": 1229, "y1": 285, "h": 45, "text": "world a little better than he found it, will wish Mr."}, {"x0": 190, "y0": 290, "x1": 1236, "y1": 345, "h": 55, "text": "Gladstone God-speed in his new, inspiring task \u2014"}, {"x0": 189, "y0": 348, "x1": 1227, "y1": 394, "h": 46, "text": "a task which is indeed \u201ctoo great for haste, too"}, {"x0": 188, "y0": 403, "x1": 533, "y1": 450, "h": 47, "text": "high for rivalry.\u201d"}, {"x0": 673, "y0": 1924, "x1": 729, "y1": 1968, "h": 44, "text": "82"}]