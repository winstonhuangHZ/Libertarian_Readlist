{"body": [{"y0": 66.9, "x0": 66.9, "x1": 223.7, "text": "Quintus: \"Iülia puella proba est.\""}, {"y0": 84.2, "x0": 40.6, "x1": 310.3, "text": "35 — Aemilia Quintum interrogat: *Ubi est Iülius? Cür"}, {"y0": 103.1, "x0": 55.8, "x1": 234.3, "text": "nón venit?\" Aemilia Iülium nón videt."}, {"y0": 121.6, "x0": 67.1, "x1": 233.4, "text": "Respondet Marcus: \"Pater dormit.\""}, {"y0": 139.8, "x0": 66.9, "x1": 273.9, "text": "Quintus: *Mater nón te, sed mé interrogat!\""}, {"y0": 158.0, "x0": 66.7, "x1": 233.1, "text": "Aemilia: *St, pueri! Ubi est pater?\""}, {"y0": 175.2, "x0": 40.3, "x1": 297.7, "text": "40 — Quintus: Pater non hic est, sed Marcus hic est.\""}, {"y0": 194.1, "x0": 66.7, "x1": 246.0, "text": "Quintus Iülium vocat: *Pater! Pa-ter!\""}, {"y0": 303.6, "x0": 66.7, "x1": 309.9, "text": "Iülius Quintum non audit neque venit. Cür Iülius"}, {"y0": 321.8, "x0": 55.4, "x1": 308.1, "text": "Quintum non audit? Iülius eum nón audit, quia dormit."}, {"y0": 339.8, "x0": 66.2, "x1": 287.8, "text": "Maàrcus: \"*Hahae! Pater dormit neque té audit.\""}, {"y0": 357.8, "x0": 38.5, "x1": 309.9, "text": "45 Aemilia: \"Fü, puer!\" Aemilia irata est. Mater filium"}, {"y0": 376.5, "x0": 55.0, "x1": 175.1, "text": "verberat: tuxtax, tuxtax..."}, {"y0": 394.7, "x0": 66.0, "x1": 184.5, "text": "Maárcus plorat: ^Uhuhü!\""}, {"y0": 412.5, "x0": 66.6, "x1": 253.8, "text": "Iülius eum audit. Iam nón dormit pater."}, {"y0": 455.0, "x0": 90.3, "x1": 170.8, "text": "007m e"}, {"y0": 449.6, "x0": 152.6, "x1": 207.5, "text": "Su"}, {"y0": 489.5, "x0": 105.6, "x1": 209.7, "text": "Pes f cA"}, {"y0": 508.6, "x0": 107.1, "x1": 263.8, "text": "Boon NI 224572)"}, {"y0": 517.6, "x0": 103.6, "x1": 259.7, "text": "HL 28. 87 NH"}], "margin": [{"y0": 86.9, "x0": 323.9, "x1": 396.1, "text": "cur Jülius nón venit?"}, {"y0": 187.1, "x0": 341.9, "x1": 355.3, "text": "M"}, {"y0": 189.1, "x0": 329.3, "x1": 387.7, "text": "PATER QN"}, {"y0": 206.0, "x0": 382.3, "x1": 384.6, "text": "U"}, {"y0": 271.5, "x0": 339.4, "x1": 379.0, "text": "d LL"}, {"y0": 287.0, "x0": 330.8, "x1": 404.9, "text": "Quintus Iülium vocat"}, {"y0": 306.1, "x0": 323.2, "x1": 380.1, "text": "ne-que - et nón"}, {"y0": 314.4, "x0": 327.5, "x1": 368.4, "text": "(ne- - nón)"}, {"y0": 323.4, "x0": 323.2, "x1": 374.7, "text": "eum : Quintum"}, {"y0": 332.6, "x0": 322.9, "x1": 368.6, "text": "Iulius dormit"}, {"y0": 378.1, "x0": 322.9, "x1": 392.5, "text": "verberat — pulsat et"}, {"y0": 387.3, "x0": 327.2, "x1": 385.5, "text": "pulsat (*tux-tax?)"}, {"y0": 414.1, "x0": 322.5, "x1": 372.4, "text": "eum : Màrcum"}]}