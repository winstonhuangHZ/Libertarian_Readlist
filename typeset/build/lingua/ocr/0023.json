{"body": [{"y0": 67.2, "x0": 140.5, "x1": 169.8, "text": "Verbum"}, {"y0": 80.7, "x0": 149.9, "x1": 318.3, "text": "Iülia cantat. Màrcus ridet. Iülius dormit."}, {"y0": 94.6, "x0": 150.0, "x1": 414.6, "text": "*Cantat verbum est. *Cantat, (ridet, dormit! tria verba 100"}, {"y0": 110.4, "x0": 139.6, "x1": 159.9, "text": "sunt."}, {"y0": 122.7, "x0": 150.0, "x1": 394.3, "text": "Exempla: cantat, pulsat, plorat, vocat, interrogat, verberat"}, {"y0": 136.7, "x0": 139.8, "x1": 388.2, "text": "(-at); ridet, videt, respondet (-et); dormit, venit, audit (-it)."}, {"y0": 150.0, "x0": 139.4, "x1": 351.3, "text": "Nominátivus: Accüsátivus: Verbum:"}, {"y0": 163.5, "x0": 139.6, "x1": 413.7, "text": "Marcus Iüliam pulsat. 105"}, {"y0": 177.4, "x0": 139.8, "x1": 341.2, "text": "Quintus Màrcum videt."}, {"y0": 191.6, "x0": 140.0, "x1": 342.3, "text": "Iülia Aemiliam vocat."}, {"y0": 205.5, "x0": 139.6, "x1": 361.5, "text": "Aemilia Quintum interrogat:"}, {"y0": 219.5, "x0": 139.8, "x1": 348.6, "text": "*Quis mé vocat?\""}, {"y0": 233.4, "x0": 139.8, "x1": 414.1, "text": "Quintus respondet: 110"}, {"y0": 248.1, "x0": 139.8, "x1": 342.5, "text": "\"[ülia té vocat."}, {"y0": 261.1, "x0": 139.6, "x1": 350.9, "text": "Marcus eam pulsat.\""}, {"y0": 275.1, "x0": 139.6, "x1": 355.1, "text": "Aemilia puerum verberat."}, {"y0": 289.2, "x0": 139.6, "x1": 345.3, "text": "Màrcus plorat."}, {"y0": 303.2, "x0": 140.0, "x1": 413.6, "text": "Iülius eum audit. 115"}, {"y0": 317.8, "x0": 140.0, "x1": 341.2, "text": "Iulius venit."}, {"y0": 331.7, "x0": 139.6, "x1": 371.6, "text": "*Puer probus parvam puellam non pulsat!\""}, {"y0": 345.3, "x0": 140.0, "x1": 355.1, "text": "Iülius iratus puerum improbum verberat."}, {"y0": 373.4, "x0": 140.0, "x1": 192.7, "text": "PENSVM A"}, {"y0": 387.5, "x0": 139.6, "x1": 394.8, "text": "Cür Marc- Iüliam pulsat? Marcus Iüli- pulsat, quia Iüli-"}, {"y0": 401.1, "x0": 139.6, "x1": 393.6, "text": "cantat. lülia plor-, quia Marcus e- pulsat. Iülia: \"Mamma!"}, {"y0": 414.8, "x0": 139.6, "x1": 394.7, "text": "Marcus — pulsat.\" Aemilia puell- aud- et ven-. Mater"}, {"y0": 428.7, "x0": 139.8, "x1": 394.5, "text": "Quint- videt et e- interrog-: ^Quis mé voc-?\" Quint- re-"}, {"y0": 443.1, "x0": 139.8, "x1": 246.2, "text": "spond-: \"Iülia — vocat.\""}, {"y0": 457.1, "x0": 150.0, "x1": 394.3, "text": "Iülius dorm-. Quintus Iüli- voc-: *Pater!\" Marcus rid-,"}, {"y0": 471.2, "x0": 139.6, "x1": 394.3, "text": "quia Iüli- nón venit. Aemilia Marc- verber-. lülius ven-,"}, {"y0": 484.7, "x0": 139.6, "x1": 394.8, "text": "quia Marc- plorat. Iülius Aemili- et Marc- et Quint- et Iüli-"}, {"y0": 498.5, "x0": 139.6, "x1": 394.5, "text": "videt. Iülius: *Puer qui parv- puell- pulsat improbus est.\""}, {"y0": 512.2, "x0": 140.1, "x1": 394.7, "text": "Iülius puer- improb- verberat. Quem Iüli- verberat? Puer"}, {"y0": 526.6, "x0": 139.6, "x1": 394.3, "text": "qu- Iülius verberat est Màrcus. Marcus plor-. Puer qu- pló-"}, {"y0": 540.6, "x0": 140.0, "x1": 328.2, "text": "rat laet- non est. Puella qu- cantat laet- est."}], "margin": [{"y0": 83.1, "x0": 39.0, "x1": 60.4, "text": "cantat"}, {"y0": 90.6, "x0": 39.2, "x1": 55.0, "text": "ridet"}, {"y0": 99.6, "x0": 39.0, "x1": 62.9, "text": "dormit"}, {"y0": 128.8, "x0": 39.0, "x1": 48.2, "text": "-at"}, {"y0": 137.4, "x0": 39.0, "x1": 140.0, "text": "-et |"}, {"y0": 145.5, "x0": 39.0, "x1": 46.2, "text": "-it"}, {"y0": 174.9, "x0": 62.6, "x1": 76.4, "text": "-um"}, {"y0": 180.6, "x0": 62.9, "x1": 140.2, "text": "-am |"}, {"y0": 190.2, "x0": 38.8, "x1": 96.4, "text": "-us | eum |-at"}, {"y0": 201.7, "x0": 38.8, "x1": 96.4, "text": "-a eam |-et"}, {"y0": 208.7, "x0": 64.4, "x1": 140.0, "text": "mé |-it |"}, {"y0": 219.0, "x0": 66.5, "x1": 140.2, "text": "té |"}, {"y0": 236.4, "x0": 140.0, "x1": 140.2, "text": "|"}, {"y0": 431.2, "x0": 140.0, "x1": 140.2, "text": "|"}, {"y0": 474.6, "x0": 139.6, "x1": 140.2, "text": "["}, {"y0": 488.4, "x0": 139.6, "x1": 140.2, "text": "["}, {"y0": 530.4, "x0": 139.6, "x1": 140.2, "text": "["}]}