{"body": [{"y0": 66.2, "x0": 40.3, "x1": 104.9, "text": "20 [D.:] Duo."}, {"y0": 84.3, "x0": 55.8, "x1": 106.0, "text": "[M.:] Quir?"}, {"y0": 102.3, "x0": 55.8, "x1": 309.4, "text": "[D.:] Singularis, ut hic magister, plüralis, ut A? magistri."}, {"y0": 138.9, "x0": 55.8, "x1": 212.0, "text": "[M.:] Càsüs nóminum quot sunt?"}, {"y0": 157.2, "x0": 40.3, "x1": 101.1, "text": "25 [D.:] Sex."}, {"y0": 175.4, "x0": 55.8, "x1": 106.3, "text": "[M.:] Qui?"}, {"y0": 193.8, "x0": 55.9, "x1": 310.3, "text": "[D.:] Nominàtivus, genetivus, dativus, accüsativus, vo-"}, {"y0": 212.1, "x0": 55.4, "x1": 309.9, "text": "cativus, ablativus. Per hós omnium generum nomina,"}, {"y0": 230.1, "x0": 55.4, "x1": 221.5, "text": "pronómina, participia declinantur..."}, {"y0": 248.0, "x0": 40.5, "x1": 238.8, "text": "30 [M.:] Comparáàtionis gradüs quot sunt?"}, {"y0": 266.9, "x0": 56.1, "x1": 104.2, "text": "[D.:] Tres."}, {"y0": 285.0, "x0": 56.1, "x1": 106.3, "text": "[M.:] Qui?"}, {"y0": 302.9, "x0": 56.1, "x1": 310.3, "text": "[D.:] Positivus, ut doctus, comparàtivus, ut doctior, su-"}, {"y0": 321.2, "x0": 55.4, "x1": 171.7, "text": "perlàtivus, ut doctissimus."}, {"y0": 339.2, "x0": 40.8, "x1": 214.3, "text": "35 [M.:] Quae nómina comparantur?"}, {"y0": 357.6, "x0": 56.1, "x1": 310.5, "text": "[D.:] Appellativa dumtaxat qualitàtem aut quantitatem"}, {"y0": 375.9, "x0": 55.8, "x1": 128.3, "text": "significantia. ..."}, {"y0": 412.3, "x0": 55.0, "x1": 117.0, "text": "Dé pronomine"}, {"y0": 429.6, "x0": 56.1, "x1": 178.0, "text": "[M.:] Prónómen quid est?"}, {"y0": 448.7, "x0": 39.9, "x1": 310.6, "text": "40 [D.:] Pars oràtionis quae pró nomine posita tantundem"}, {"y0": 466.8, "x0": 55.6, "x1": 290.1, "text": "paene significat persónamque interdum recipit. ..."}, {"y0": 484.8, "x0": 56.1, "x1": 235.0, "text": "[M.:] Genera prónoóminum quae sunt?"}, {"y0": 503.2, "x0": 56.1, "x1": 310.6, "text": "[D.:] Eadem feré quae et nóominum: masculinum, ut"}, {"y0": 521.6, "x0": 55.8, "x1": 310.5, "text": "quis, femininum, ut quae, neutrum, ut quod, commüne,"}, {"y0": 539.6, "x0": 40.1, "x1": 250.5, "text": "45 ut quàlis, tàlis, trium generum, ut ego, tà."}], "margin": [{"y0": 249.4, "x0": 324.1, "x1": 389.1, "text": "comparatio -onis f"}, {"y0": 259.5, "x0": 329.0, "x1": 374.7, "text": "« comparàre"}, {"y0": 349.8, "x0": 324.3, "x1": 391.4, "text": "appellàtiva: scilicet"}, {"y0": 359.0, "x0": 328.4, "x1": 359.6, "text": "adiectiva"}, {"y0": 368.0, "x0": 324.3, "x1": 393.8, "text": "dumtaxat — tantum"}, {"y0": 377.0, "x0": 324.1, "x1": 404.6, "text": "qualitàs -àtis f « qualis"}, {"y0": 386.0, "x0": 324.1, "x1": 408.9, "text": "quantitas -àtis f « quan-"}, {"y0": 396.6, "x0": 328.6, "x1": 338.7, "text": "tus"}, {"y0": 450.1, "x0": 324.3, "x1": 407.3, "text": "tantun-dem (« tantum-"}, {"y0": 458.9, "x0": 329.3, "x1": 376.1, "text": "dem) — idem"}, {"y0": 504.8, "x0": 324.1, "x1": 360.7, "text": "et — etiam"}, {"y0": 532.2, "x0": 318.0, "x1": 318.2, "text": "|"}, {"y0": 539.9, "x0": 318.0, "x1": 318.2, "text": "|"}]}