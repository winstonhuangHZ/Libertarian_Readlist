{"body": [{"y0": 70.1, "x0": 167.1, "x1": 314.0, "text": "hortus —-— villa"}, {"y0": 114.4, "x0": 195.2, "x1": 376.8, "text": "| — P. td LUMLLLLLEIPNANLLLTT MI LHTEPPPPQUE LUPO UELNL OIM LCT"}, {"y0": 149.7, "x0": 149.7, "x1": 392.3, "text": "I ISRUTATMISE"}, {"y0": 201.7, "x0": 218.6, "x1": 322.1, "text": "VILLA ET HORTVS"}, {"y0": 230.7, "x0": 143.2, "x1": 410.7, "text": "Ecce villa et hortus Iülii. Iülius in magná villà habitat. 7"}, {"y0": 248.9, "x0": 143.2, "x1": 397.9, "text": "Pater et màter et tres liberi in villa habitant. Iülius et"}, {"y0": 263.1, "x0": 142.8, "x1": 397.9, "text": "Aemilia trés liberos habent: duós filios et ünam filiam"}, {"y0": 285.4, "x0": 142.3, "x1": 227.8, "text": "— nón duas filiàs."}, {"y0": 303.8, "x0": 154.2, "x1": 408.7, "text": "In villà multi servi habitant. Dominus eórum est Iü- 5"}, {"y0": 321.8, "x0": 142.8, "x1": 397.9, "text": "lius: is multos servos habet. Ancillae quoque multae in"}, {"y0": 339.8, "x0": 142.7, "x1": 397.9, "text": "villa habitant. Domina eàrum est Aemilia: ea multas"}, {"y0": 357.9, "x0": 142.7, "x1": 208.2, "text": "ancillas habet."}, {"y0": 376.5, "x0": 154.0, "x1": 397.7, "text": "Iulius in villà sua habitat cum magnà familia. Pater et"}, {"y0": 394.7, "x0": 142.5, "x1": 412.3, "text": "mater habitant cum Marco et Quinto et Iülia. Iülius et 10"}, {"y0": 412.5, "x0": 142.5, "x1": 396.5, "text": "Aemilia in villà habitant cum liberis et servis et ancillis."}, {"y0": 430.8, "x0": 153.5, "x1": 397.5, "text": "Villa Iülit in magno horto est. In Italia sunt multae"}, {"y0": 449.2, "x0": 142.1, "x1": 396.6, "text": "villae cum magnis hortis. In hortis sunt rosae et lilia."}, {"y0": 467.6, "x0": 142.7, "x1": 396.5, "text": "Iülius multàs rosas et multa lilia in horto suó habet."}, {"y0": 485.6, "x0": 142.5, "x1": 411.6, "text": "Hortus Iülii pulcher est, quia in eó sunt multae et pul- 15"}, {"y0": 503.6, "x0": 142.3, "x1": 234.6, "text": "chrae rosae liliaque."}, {"y0": 521.9, "x0": 153.3, "x1": 397.4, "text": "Aemilia femina pulchra est. Syra nón est fémina pul-"}, {"y0": 540.5, "x0": 142.1, "x1": 396.5, "text": "chra, neque pulcher est nàsus eius, sed foedus est."}], "margin": [{"y0": 305.9, "x0": 41.0, "x1": 100.0, "text": "eorum : servorum"}, {"y0": 323.4, "x0": 41.2, "x1": 73.0, "text": "is : Iülius"}, {"y0": 340.7, "x0": 41.0, "x1": 105.4, "text": "earum : ancillarum"}, {"y0": 350.4, "x0": 41.0, "x1": 83.5, "text": "ea : Aemilia"}, {"y0": 369.5, "x0": 41.0, "x1": 59.0, "text": "-à -à:"}, {"y0": 377.9, "x0": 45.1, "x1": 100.7, "text": "in hortó, in villa"}, {"y0": 387.1, "x0": 44.9, "x1": 119.8, "text": "cum Márcó, cum Iulia"}, {"y0": 396.8, "x0": 41.0, "x1": 51.2, "text": "-is:"}, {"y0": 405.1, "x0": 45.1, "x1": 103.1, "text": "in hortis, in villis"}, {"y0": 414.5, "x0": 44.9, "x1": 124.3, "text": "cum servis, cum ancillis"}, {"y0": 453.0, "x0": 48.9, "x1": 114.2, "text": "AS CN d:"}, {"y0": 467.9, "x0": 53.9, "x1": 103.6, "text": "rosa lilium"}, {"y0": 486.1, "x0": 40.6, "x1": 73.6, "text": "eó : hortó"}, {"y0": 495.1, "x0": 41.0, "x1": 118.4, "text": "pulcher -chra -chrum:"}, {"y0": 503.9, "x0": 45.1, "x1": 109.4, "text": "hortus pulcher (m)"}, {"y0": 513.1, "x0": 45.3, "x1": 98.4, "text": "rosa pulchra (f)"}, {"y0": 522.3, "x0": 45.1, "x1": 112.8, "text": "lilium pulchrum (1)"}, {"y0": 540.8, "x0": 40.6, "x1": 80.2, "text": "eius : Syrae"}, {"y0": 549.8, "x0": 41.0, "x1": 129.9, "text": "foedus -a -um €» pulcher"}]}